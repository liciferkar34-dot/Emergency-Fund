rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isApproved() { return isSignedIn() && userDoc().approvalStatus == 'approved'; }
    function isAdmin() { return isApproved() && userDoc().role == 'admin'; }
    function isStaff() { return isApproved() && (userDoc().role == 'admin' || userDoc().role == 'co_admin'); }

    // Strict Unique Phone Lookup
    match /phone_lookup/{phone} {
      allow read: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/phone_lookup/$(phone));
      allow update, delete: if false;
    }

    // Users Collection with Strict Auto-Admin Enforcement
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isApproved());
      allow create: if isSignedIn() && request.auth.uid == uid && (
        (
          request.resource.data.email == 'dhananjoyk049@gmail.com' &&
          request.resource.data.phone == '9832420007' &&
          request.resource.data.role == 'admin' &&
          request.resource.data.approvalStatus == 'approved'
        ) || (
          request.resource.data.role == 'member' &&
          request.resource.data.approvalStatus == 'pending'
        )
      );
      allow update: if isStaff() || (
        isApproved() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.totalPaid == resource.data.totalPaid &&
        request.resource.data.pendingFine == resource.data.pendingFine
      );
      allow delete: if false;
    }

    // Transactions
    match /transactions/{txId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update: if isStaff();
      allow delete: if false;
    }

    // Emergency Loans
    match /loans/{loanId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update: if isApproved();
      allow delete: if false;
    }

    // Immutable Audit Logs (Nobody can edit or delete, including Admins!)
    match /audit_logs/{logId} {
      allow read: if isApproved();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Fund Settings
    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
  }
}
